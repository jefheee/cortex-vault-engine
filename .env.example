# Chaves da API Gemini (suporta pool de ate 10 chaves com failover automatico)
GEMINI_API_KEY_1=cole_sua_chave_principal_aqui
GEMINI_API_KEY_2=cole_sua_chave_reserva_2_aqui
GEMINI_API_KEY_3=cole_sua_chave_reserva_3_aqui

# Roteamento de Modelos Oficiais Gemini (Cortex Vault Engine V6.0)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
HEAVY_INPUT_THRESHOLD_CHARS=12000

# Ordem de fallback automatico quando cota/RPM/404 ocorrer em uma chave
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-pro,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-2.0-flash

# Caminho opcional da raiz do Vault (se omitido, usa a pasta pai de .automacao)
# VAULT_ROOT=G:\Meu Drive\Obsidian

# Tempos de debounce e varredura ativa (Chokidar polling + fs.readdir)
DEBOUNCE_SECONDS=45
INBOX_BRUTO_DEBOUNCE_SECONDS=5
ACTIVE_SCAN_INTERVAL_SECONDS=30
EMPTY_CLEANUP_MINUTES=15
